<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core as a mapper, not as a schema authority. The tables are created by
      the .sql in Migrations/, applied by the platform's own migrator with a
      checksum per script; EF is never asked to generate or apply a migration,
      and `dotnet ef` is not part of any workflow here. What it buys is the
      row-to-object mapping and the paging, which is the part of a product
      module that is pure tedium.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IslaPay.Marketplace.Contracts\IslaPay.Marketplace.Contracts.csproj" />
    <!--
      Two other modules, both through their .Contracts: the ledger moves the
      money, and Identity says who the seller is and whether the buyer has
      proved a phone. Neither module's internals are reachable from here.
    -->
    <ProjectReference Include="..\..\Ledger\IslaPay.Ledger.Contracts\IslaPay.Ledger.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\IslaPay.Identity.Contracts\IslaPay.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Platform\IslaPay.Platform.AspNet\IslaPay.Platform.AspNet.csproj" />
    <ProjectReference Include="..\..\..\Platform\IslaPay.Platform.Data\IslaPay.Platform.Data.csproj" />
  </ItemGroup>

</Project>
