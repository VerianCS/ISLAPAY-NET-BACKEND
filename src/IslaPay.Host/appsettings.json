{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://localhost:8080",
    "Realm": "islapay",
    "ClientId": "islapay-app",
    "AdminClientId": "islapay-admin",
    "Audience": "islapay-api"
  },
  "Data": {
    "ConnectionString": "Host=localhost;Port=5432;Database=islapay;Username=postgres;Password=postgres",
    "MigrateOnStartup": false
  },
  "Security": {
    "RequireMultiFactor": true
  }
}
