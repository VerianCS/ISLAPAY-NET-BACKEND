<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      Shared fixtures, not a suite. It references xunit so fixtures can
      implement IAsyncLifetime, and `dotnet test` on the solution will
      otherwise try to run it: a library's output carries no NuGet
      assemblies, so the test host starts, fails to resolve them from the
      deps manifest, and aborts the whole run with exit code 1 while every
      real suite reports green. Which is exactly how this was found.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The platform only. Shared test infrastructure that referenced a module
      would hand every other module's tests a dependency on it, which is the
      coupling the architecture tests exist to prevent — and they would not
      catch it here, because a support project is not a module's tests.
    -->
    <ProjectReference Include="..\..\..\src\Platform\IslaPay.Platform.Data\IslaPay.Platform.Data.csproj" />
    <ProjectReference Include="..\..\..\src\Platform\IslaPay.Platform.Messaging\IslaPay.Platform.Messaging.csproj" />
  </ItemGroup>

</Project>
